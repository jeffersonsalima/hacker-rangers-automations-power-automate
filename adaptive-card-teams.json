{
  "type": "AdaptiveCard",
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.3",
  "body": [
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "SUA GERÊNCIA AQUI",
          "wrap": true,
          "size": "ExtraLarge",
          "weight": "Bolder",
          "horizontalAlignment": "Center",
          "color": "Light",
          "spacing": "None"
        },
        {
          "type": "TextBlock",
          "text": "SUA ÁREA AQUI",
          "wrap": true,
          "horizontalAlignment": "Center",
          "size": "Large",
          "color": "Light",
          "weight": "Bolder",
          "spacing": "None"
        }
      ],
      "backgroundImage": {
        "url": "data:image/gif;base64,@{outputs('IMG_TOPO')}"
      }
    },
    {
      "type": "Container",
      "items": [
        {
          "type": "RichTextBlock",
          "horizontalAlignment": "Center",
          "spacing": "Medium",
          "inlines": [
            {
              "type": "TextRun",
              "text": "Sua Atenção é Necessária! 🎯",
              "weight": "Bolder",
              "size": "ExtraLarge",
              "color": "Attention"
            },
            {
              "type": "TextRun",
              "text": " \nPlataforma Hacker Rangers",
              "weight": "Bolder",
              "size": "Large",
              "color": "Good"
            }
          ]
        }
      ],
      "spacing": "Medium",
      "separator": true
    },
    {
      "type": "Container",
      "style": "emphasis",
      "items": [
        {
          "type": "TextBlock",
          "text": "@{outputs('Mencionar_Usuário')?['body/atMention']}",
          "wrap": true,
          "horizontalAlignment": "Center",
          "isVisible": false,
          "spacing": "None"
        },
        {
          "type": "TextBlock",
          "text": "Olá, @{items('Para_Cada_Usuário')?['GivenName']} 👾",
          "wrap": true,
          "horizontalAlignment": "Center",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Accent"
        },
        {
          "type": "RichTextBlock",
          "wrap": true,
          "horizontalAlignment": "Center",
          "spacing": "Small",
          "inlines": [
            {
              "type": "TextRun",
              "text": "Você possui ",
              "color": "Warning",
              "weight": "Bolder"
            },
            {
              "type": "TextRun",
              "text": "@{string(outputs('Total_Cursos_Pendentes'))}",
              "weight": "Bolder",
              "size": "Large",
              "color": "Attention"
            },
  {
              "type": "TextRun",
              "text": " curso(s) e ",
              "color": "Warning",
              "weight": "Bolder"
            },
  {
              "type": "TextRun",
              "text": "@{string(outputs('Total_Quizzes_Pendentes'))}",
              "weight": "Bolder",
              "size": "Large",
              "color": "Attention"
            },
            {
              "type": "TextRun",
              "text": " quiz(zes) pendente(s) aguardando conclusão!",
              "color": "Warning",
              "weight": "Bolder"
            }
          ]
        },
        {
          "type": "RichTextBlock",
          "wrap": true,
          "horizontalAlignment": "Center",
          "spacing": "Small",
          "inlines": [
            {
              "type": "TextRun",
              "text": "Cibersegurança é uma responsabilidade de todos! 🔐",
              "color": "Accent",
              "weight": "Bolder"
            },
            {
              "type": "TextRun",
              "text": " \nGaranta seus pontos na temporada e ajude a manter a ",
              "color": "Accent"
            },
            {
              "type": "TextRun",
              "text": "nossa empresa segura!🛡️",
              "color": "Accent",
              "weight": "Bolder"
            }
          ]
        },
        {
          "type": "ColumnSet",
          "horizontalAlignment": "Center",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "ActionSet",
                  "actions": [
                    {
                      "type": "Action.OpenUrl",
                      "title": "🚀 Acesse a plataforma Hacker Rangers",
                      "url": "https://suaempresa.hackerrangers.com",
                      "style": "positive"
                    }
                  ]
                }
              ]
            }
          ],
          "spacing": "Medium"
        },
        {
          "type": "TextBlock",
          "text": "📅 A temporada atual se encerra em @{outputs('Temporada')}! ⌛",
          "wrap": true,
          "horizontalAlignment": "Center",
          "weight": "Bolder",
          "size": "Default",
          "color": "Attention",
          "spacing": "Medium"
        }
      ],
      "spacing": "Small"
    },
    {
      "type": "Container",
      "backgroundImage": {
        "url": "data:image/gif;base64,@{outputs('IMG_RODAPE')}"
      },
      "items": [
        {
          "type": "TextBlock",
          "text": "👾 Relatório das suas missões na área e entregue! 👾",
          "wrap": true,
          "weight": "Bolder",
          "size": "Default",
          "color": "Light",
          "horizontalAlignment": "Center"
        },
        {
          "type": "TextBlock",
          "text": "@{formatDateTime(convertTimeZone(utcNow(), 'UTC', 'E. South America Standard Time'), 'dd/MM/yyyy "às" HH:mm:ss')}",
          "wrap": true,
          "weight": "Bolder",
          "size": "Default",
          "color": "Light",
          "spacing": "ExtraSmall",
          "horizontalAlignment": "Center"
        }
      ],
      "separator": true,
      "spacing": "Medium"
    }
  ]
}